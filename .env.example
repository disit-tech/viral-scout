# Copy to .env (git-ignored). Real environment variables win over this file.

# Newer yt-dlp clone instead of the pip package (recommended: Instagram/YouTube extractors change often)
VIRAL_SCOUT_YTDLP=D:/repo/yt-dlp

# Obsidian vault root (the folder with .obsidian/). Profiles use ${OBSIDIAN_VAULT}/projects/<project>/... for reports and
# the swipe file. Better as a user environment variable: the dashboard and the scheduled analyze step read that, not .env.
# OBSIDIAN_VAULT=D:/Obsidian/vault

# Optional: Netscape cookies.txt for yt-dlp (your own login; only if a site starts asking for one)
# VIRAL_SCOUT_COOKIES=

# Optional: Connect Meta. One Facebook sign-in fills the IG_GRAPH_*, META_ADS_*, META_AD_LIBRARY_TOKEN keys below
# (python -m viral_scout keys connect meta, or Setup → Sign in with Facebook; docs/setup.md#connect-meta)
# META_APP_ID=
# META_APP_SECRET=
# META_LOGIN_CONFIG_ID=            # only for a Facebook Login for Business configuration
# META_USER_TOKEN=                 # written by the sign-in (~60 days)

# Optional: Connect TikTok (TikTok for Business developer app; docs/setup.md#connect-tiktok)
# TIKTOK_APP_ID=
# TIKTOK_APP_SECRET=
# TIKTOK_APP_REDIRECT_URI=http://localhost:8766/

# Optional: Instagram watch list through the official Graph API (Business Discovery)
# IG_GRAPH_TOKEN=
# IG_GRAPH_USER_ID=

# Optional: TikTok discovery and watch list through Apify (paid per result)
# APIFY_TOKEN=
# VIRAL_SCOUT_MCP_PAID=0              # 1 = MCP clients may start paid runs (start_run, ads_run, local_competitors)
# APIFY_MAX_USD_PER_RUN=0.5          # spend cap per Apify actor run (Apify maxTotalChargeUsd); 0 = no cap
# APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper

# Optional: ads scout (python -m viral_scout ads <profile>), see docs/ads-scout.md
# META_AD_LIBRARY_TOKEN=            # Meta Ad Library API: EU-delivered ads + political ads (no US commercial ads)
# META_GRAPH_VERSION=v26.0
# TIKTOK_RESEARCH_CLIENT_KEY=       # TikTok Commercial Content API (EEA ads), after approval
# TIKTOK_RESEARCH_CLIENT_SECRET=
# APIFY_ADS_ACTOR=apify~facebook-ads-scraper   # Meta Ad Library for any country incl. the US (paid, uses APIFY_TOKEN)
# APIFY_TIKTOK_ADS_ACTOR=pulsedata~tiktok-creative-center-top-ads-scraper   # TikTok Creative Center Top Ads ($2/1,000 ads; set ads.tiktok_top_input.industries)
# APIFY_GOOGLE_ADS_ACTOR=automation-lab~google-ads-scraper   # Google Ads Transparency Center (~$1/1,000 ads)
# Optional: Your performance (your own accounts only; see docs/performance.md)
# YT_OAUTH_CLIENT_ID=
# YT_OAUTH_CLIENT_SECRET=
# YT_OAUTH_REFRESH_TOKEN=      # written by: python -m viral_scout keys connect google (also GOOGLE_ADS_REFRESH_TOKEN)
# META_ADS_TOKEN=
# META_AD_ACCOUNT_ID=
# TIKTOK_ADS_TOKEN=              # with TIKTOK_ADVERTISER_ID: filled by keys connect tiktok
# TIKTOK_ADVERTISER_ID=

# Content studio: the Telegram bot service (service/, deployed on Vercel). `ideas <profile> status` and the
# dashboard's Bots page ask it whether each business's bots are connected. Default: the ideas API's own URL.
# STUDIO_SERVICE_URL=https://your-service.vercel.app
