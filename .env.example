# Copy to .env (git-ignored). Real environment variables win over this file.

# Newer yt-dlp clone instead of the pip package (recommended: Instagram/YouTube extractors change often)
VIRAL_SCOUT_YTDLP=D:/repo/yt-dlp

# Optional: Netscape cookies.txt for yt-dlp (your own login; only if a site starts asking for one)
# VIRAL_SCOUT_COOKIES=

# Optional: Instagram watch list through the official Graph API (Business Discovery)
# IG_GRAPH_TOKEN=
# IG_GRAPH_USER_ID=

# Optional: TikTok discovery and watch list through Apify (paid per result)
# APIFY_TOKEN=
# APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper

# Optional: Your performance (your own accounts only; see docs/performance.md)
# YT_OAUTH_CLIENT_ID=
# YT_OAUTH_CLIENT_SECRET=
# YT_OAUTH_REFRESH_TOKEN=      # written by: python -m viral_scout perf auth youtube
# META_ADS_TOKEN=
# META_AD_ACCOUNT_ID=
# TIKTOK_ADS_TOKEN=
# TIKTOK_ADVERTISER_ID=
