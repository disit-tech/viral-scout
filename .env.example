# Copy to .env (git-ignored). Real environment variables win over this file.

# Newer yt-dlp clone instead of the pip package (recommended: Instagram/YouTube extractors change often)
VIRAL_SCOUT_YTDLP=D:/repo/yt-dlp

# Optional: Netscape cookies.txt for yt-dlp (your own login; only if a site starts asking for one)
# VIRAL_SCOUT_COOKIES=

# Optional: Instagram watch list through the official Graph API (Business Discovery)
# IG_GRAPH_TOKEN=
# IG_GRAPH_USER_ID=

# Optional: TikTok discovery and watch list through Apify (paid per result)
# APIFY_TOKEN=
# APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper

# Optional: ads scout (python -m viral_scout ads <profile>), see docs/ads-scout.md
# META_AD_LIBRARY_TOKEN=            # Meta Ad Library API: EU-delivered ads + political ads (no US commercial ads)
# META_GRAPH_VERSION=v26.0
# TIKTOK_RESEARCH_CLIENT_KEY=       # TikTok Commercial Content API (EEA ads), after approval
# TIKTOK_RESEARCH_CLIENT_SECRET=
# APIFY_ADS_ACTOR=apify~facebook-ads-scraper   # Meta Ad Library for any country incl. the US (paid, uses APIFY_TOKEN)
# APIFY_TIKTOK_ADS_ACTOR=           # TikTok Creative Center Top Ads actor (paid)
# APIFY_GOOGLE_ADS_ACTOR=           # Google Ads Transparency Center actor (paid)
