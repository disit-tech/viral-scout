# Telegram ideas service. Copy to .env.local for local runs; on Vercel set these in Project → Settings → Environment Variables.
# Names here must match the *Env fields in projects.json. Never commit real values.

# Database: the solar site's Turso DB (same tables as the CRM pages). Leave empty locally: a scratch file data/local.db is used.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Full API key for /api/ideas and /api/blog-review (same value as the solar site's IDEAS_API_SECRET, so the ideas CLI works unchanged)
IDEAS_API_SECRET=

# Chats the bots work in, comma-separated (same as the solar site's TELEGRAM_CHAT_ID)
TELEGRAM_CHAT_ID=

# Bot tokens (projects.json → bots.<slug>.tokenEnv)
TELEGRAM_IDEAS_BOT_TOKEN=
TELEGRAM_AGENCY_IDEAS_BOT_TOKEN=
TELEGRAM_HOMES_IDEAS_BOT_TOKEN=

# secret_token given to setWebhook for the bots whose webhook is this service (bots.<slug>.webhookSecretEnv).
# Telegram allows A-Z a-z 0-9 _ - (1 to 256 characters).
TELEGRAM_WEBHOOK_SECRET=

# Homeworks: the shared secret the Homeworks site forwards idea updates with (its IDEAS_FORWARD_SECRET), also its CRM key
# for /api/ideas (bots.homes.forwardSecretEnv and projects.homes.crmSecretEnv)
HOMES_FORWARD_SECRET=

# Optional: the whole projects.json as one JSON string; wins over the file
STUDIO_CONFIG_JSON=
