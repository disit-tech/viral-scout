{
  "$comment": "Projects and bots of the ideas service. Secrets are never here: only the names of the env vars that hold them. Reference: docs/telegram-service.md.",
  "defaultProject": "solar",
  "defaultBot": "ideas",
  "chatsEnv": "TELEGRAM_CHAT_ID",
  "scriptsBot": "ideas",
  "blog": { "bot": "ideas", "publicUrl": "https://solar.example.com/blog/" },
  "bots": {
    "ideas": {
      "tokenEnv": "TELEGRAM_IDEAS_BOT_TOKEN",
      "webhookSecretEnv": "TELEGRAM_WEBHOOK_SECRET",
      "notes": "replies+call"
    },
    "agency": {
      "tokenEnv": "TELEGRAM_AGENCY_IDEAS_BOT_TOKEN",
      "webhookSecretEnv": "TELEGRAM_WEBHOOK_SECRET",
      "notes": "replies"
    },
    "homes": {
      "tokenEnv": "TELEGRAM_HOMES_IDEAS_BOT_TOKEN",
      "forwardSecretEnv": "HOMES_FORWARD_SECRET",
      "notes": "off"
    }
  },
  "projects": {
    "solar": { "bot": "ideas", "label": "", "reasonSet": "video", "packs": false },
    "homes": {
      "bot": "homes",
      "label": "🔨 Homeworks · ",
      "reasonSet": "video",
      "packs": true,
      "crmSecretEnv": "HOMES_FORWARD_SECRET"
    },
    "agency": { "bot": "agency", "label": "🏢 Acme Agency · ", "reasonSet": "video", "packs": false }
  },
